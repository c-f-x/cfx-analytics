{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A template: local development and tests only. A deployment's values (its
  // account, hostnames and resource ids) live in the private site file, and
  // `pnpm ops` joins them in at deploy time (D-32, scripts/lib/site.mjs).
  // Sign-in values are Worker secrets (D-27). scripts/wrangler-config.test.mjs
  // fails on any deployment value or secret in this file.
  "name": "cfanalytics-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker's secrets, so a deploy fails while one is missing, and
  // apps/worker/.dev.vars.example names the same ones for local runs. Wrangler
  // does not inherit this into named environments, so the deploy copies it in.
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "ADMIN_EMAIL",
      "DASHBOARD_ORIGIN",
      "CLOUDFLARE_CLIENT_ID",
      "CLOUDFLARE_CLIENT_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },
  // ProjectStore schema steps are .sql files imported as text (src/platform/steps.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "REGISTRY",
      "database_name": "cfanalytics-registry-local",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  // The weekly email (#23): mail.ts sends through this binding, Mondays at
  // 06:00 UTC. The deploy restricts it to the site file's alert addresses.
  "send_email": [{ "name": "MAIL" }],
  "triggers": { "crons": ["0 6 * * 1"] },
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_STORE", "class_name": "ProjectStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectStore"] }],
  "r2_buckets": [
    {
      "binding": "RECORDINGS",
      "bucket_name": "cfanalytics-recordings-local"
    }
  ],
  // The pinned posthog-js lazy scripts (D-15), copied byte for byte by
  // scripts/posthog-scripts.mjs. The Worker runs first on every path, so a
  // script is only ever served by the config slice, with its CORS headers and
  // cache lifetime, and only at the paths posthog-js asks for (config-25).
  "assets": {
    "directory": "assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
