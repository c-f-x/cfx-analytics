{
  "name": "cfx-analytics",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint --type-aware && biome check .",
    "lint:fix": "oxlint --type-aware --fix && biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "test": "pnpm -r test && node --test \"scripts/**/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "docs:gen": "node scripts/docs-gen.mjs",
    "migrations:lock": "node scripts/migrations-lock.mjs",
    "wave:gate": "node scripts/wave-gate.mjs",
    "test:size": "pnpm --filter @cfanalytics/worker test:size",
    "compat": "node apps/compat/run.mjs",
    "e2e": "node apps/compat/dashboard.mjs",
    "ops": "node scripts/ops.mjs",
    "smoke": "node apps/compat/smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@c-f-x/kit": "https://github.com/c-f-x/cfx-kit/releases/download/v0.3.0/c-f-x-kit-0.3.0.tgz",
    "@types/node": "26.6.6",
    "jsonc-parser": "3.3.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  }
}
